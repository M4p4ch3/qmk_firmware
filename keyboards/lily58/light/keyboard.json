{
    "keyboard_name": "Lily58L",
    "manufacturer": "Keycapsss",
    "url": "https://keycapsss.com",
    "maintainer": "BenRoe",
    "usb": {
        "vid": "0x7983",
        "pid": "0x4C4C",
        "device_version": "1.0.0"
    },
    "features": {
        "bootmagic": true,
        "encoder": true,
        "oled": true,
        "rgblight": false,
        "rgb_matrix": true
    },
    "matrix_pins": {
        "cols": ["F6", "F7", "B1", "B3", "B2", "B6"],
        "rows": ["C6", "D7", "E6", "B4", "B5"]
    },
    "diode_direction": "COL2ROW",
    "encoder": {
        "rotary": [
            {"pin_a": "F4", "pin_b": "F5"}
        ]
    },
    "split": {
        "enabled": true,
        "encoder": {
            "right": {
                "rotary": [
                    {"pin_a": "F5", "pin_b": "F4"}
                ]
            }
        },
        "serial": {
            "pin": "D2"
        }
    },
    "ws2812": {
        "pin": "D3"
    },
    "rgblight": {
        "led_count": 70,
        "max_brightness": 60,
        "split_count": [35, 35]
    },
    "development_board": "promicro",
    "build": {
        "lto": true
    },
    "layouts": {
        "LAYOUT": {
            "layout": [
                // Row 0
                //   Left hand
                {"matrix": [0, 0], "x": 0, "y": 0.5},               // ESC
                {"matrix": [0, 1], "x": 1, "y": 0.375},             // 1
                {"matrix": [0, 2], "x": 2, "y": 0.125},
                {"matrix": [0, 3], "x": 3, "y": 0},
                {"matrix": [0, 4], "x": 4, "y": 0.125},
                {"matrix": [0, 5], "x": 5, "y": 0.25},              // 5
